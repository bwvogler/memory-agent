.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.venv/
venv/
work/
mnt/
# scripts/mount-kb.sh --dev keeps its mountpoint and savepoints apart from the
# production ones, so it needs its own pair here.
work-dev/
*.log
.DS_Store
.vscode/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# bd writes a per-machine field-change log beside the ledger. Nothing here reads
# it, the Dolt database holds the authoritative history, and it is append-only
# with a machine-local actor - so committing it would mean a conflict on every
# clone that closed a bead. Ignored here rather than in .beads/.gitignore, which
# bd generates and may rewrite. Revisit if bd ever documents it as shared.
.beads/interactions.jsonl
