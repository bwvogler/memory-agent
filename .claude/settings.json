{
  "$comment": [
    "Claude Code hooks for laptop sessions in this repo. These have NO effect on",
    "the deployed app: app/agent.py sets setting_sources=[], which is exactly what",
    "makes file-based settings dead there (bead img-9g8 rejected changing that).",
    "scripts/kb_guard_hook.py explains what each one enforces and why; see",
    "docs/decisions/0019 and the kb-direct skill."
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/kb_guard_hook.py\" pre-bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/kb_guard_hook.py\" pre-write",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/kb_guard_hook.py\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
